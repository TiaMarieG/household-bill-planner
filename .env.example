# Copy to .env in the repo root (same folder as docker-compose.yml). Never commit .env.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Read by docker compose to create the Postgres container
POSTGRES_USER=planner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bill_planner
POSTGRES_PORT=5432

# Read by the backend; user, password and port must match the values above
DATABASE_URL=postgresql+psycopg://planner:change-me@localhost:5432/bill_planner
TEST_DATABASE_URL=postgresql+psycopg://planner:change-me@localhost:5432/bill_planner_test
